---
import Header from '../components/Header.astro';
import PageLink from '../components/PageLink.astro';
import SocialsButton from '../components/SocialsButton.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <Header />
	<div class="flex gap-20">
		<a href="/games" class="flex flex-col items-center justify-center border-surface">
			<h2>-- Games --</h2>
			<img
				src="/wizard.png"
				alt="wizard"
				class="w-75 h-75 [image-rendering:pixelated]"
			/>
		</a>

		<a href="/devlogs" class="flex flex-col items-center justify-center border-surface">
			<div class="flex flex-col items-center justify-center border-surface">
				<h2>-- Devlogs --</h2>
				<img
					src="/little-gremlin.png"
					alt="gremlin"
					class="w-75 h-75 [image-rendering:pixelated]"
				/>
			</div>
		</a>	
	</div>

	<!-- socials -->
	<div class="m-3 mt-5 mb-20 flex flex-wrap gap-6 justify-center">
		<SocialsButton name="GITHUB" link="https://github.com/adderscript" />
		<SocialsButton name="EMAIL" link="mailto:alasdair@adderscript.net" />
		<SocialsButton name="BUY ME A COFFEE" link="https://buymeacoffee.com/AdderScript" />
	</div>
</Layout>
