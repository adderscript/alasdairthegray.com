---
import Header from '../components/Header.astro';
import PageLink from '../components/PageButton.astro';
import SocialsButton from '../components/SocialsButton.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Header title="Alasdair The Gray.com" subtitle="An archive of my stuff that probably shouldnt be archived" />

	<div class="mt-5 flex gap-3 w-full">
		<PageLink title="Games" description="An archive of my games, with varying degrees of quality" page="/games" />
		<div class="flex-auto flex gap-3 flex-col">
			<PageLink title="Devlogs" description="A (currently empty) collection of my devlogs" page="/devlogs" />
			<PageLink title="The chatroom" description="A chatroom; a room used for chatting" page="https://chat.alasdairthegray.com/" />
		</div>
	</div>

	<!-- socials -->
	<div class="mt-5 flex w-full gap-3">
		<SocialsButton name="github" link="https://github.com/adderscript" />
		<SocialsButton name="email" link="mailto:hello@alasdairthegray.com" />
		<SocialsButton name="buy me a coffee" link="https://buymeacoffee.com/AdderScript" />
	</div>
</Layout>
