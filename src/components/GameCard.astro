---
interface Props {
    title: string;
    description: string;
    gamePage: string;
}

const  { title, description, gamePage } = Astro.props as Props;
---

<div class="p-3 border-3 border-border-inactive hover:border-border-active">
    <a href={gamePage}>
        <h2>{title}</h2>
        <h3>{description}</h3>
    </a>
</div>
