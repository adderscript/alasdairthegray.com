---
interface Props {
    name: string;
    link: string;
}

const { name, link } = Astro.props as Props;
---

<a href={link} class="flex-auto gap-2 px-4 py-2
    text-center
    border-t-3 border-border-inactive
    hover:border-border-active
    text-fg4 text-xl
    transition-all duration-100"
>
    {name}
</a>
