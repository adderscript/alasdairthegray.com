---
interface Props {
    title: string;
    subtitle: string;
}

const  { title, subtitle } = Astro.props as Props;
---

<div class="p-5 border-b-3 border-border-inactive hover:border-border-active flex flex-row items-center">
    <a href="/" class="cursor-pointer flex-1">
        <h1>{title}</h1>
        <h3>{subtitle}</h3> 
    </a>
    <img src="/wizard.png" class="w-28 shrink-0 object-contain [image-rendering:pixelated]" />
</div>
